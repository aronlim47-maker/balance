<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts: Balance's dark background with the crest,
         so there is no white flash before the first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
